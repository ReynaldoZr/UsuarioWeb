<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="520.0" prefWidth="940.0" spacing="16.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.servicioswebs.controller.UsuarioController">
    <padding>
        <Insets bottom="24.0" left="30.0" right="30.0" top="26.0"/>
    </padding>

    <Label text="Consulta de usuarios - API REST">
        <font>
            <Font name="System Bold" size="21.0"/>
        </font>
    </Label>

    <HBox alignment="CENTER_LEFT" spacing="18.0">
        <Button fx:id="btnConsultar"
                mnemonicParsing="false"
                onAction="#onConsultarUsuarios"
                prefHeight="34.0"
                text="Consultar usuarios"/>
        <Label fx:id="lblEstado" text="Presione Consultar usuarios"/>
    </HBox>

    <TableView fx:id="tablaUsuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60.0" text="ID"/>
            <TableColumn fx:id="colNombre" prefWidth="145.0" text="Nombre"/>
            <TableColumn fx:id="colUsername" prefWidth="120.0" text="Username"/>
            <TableColumn fx:id="colCorreo" prefWidth="185.0" text="Correo"/>
            <TableColumn fx:id="colTelefono" prefWidth="135.0" text="Teléfono"/>
            <TableColumn fx:id="colCiudad" prefWidth="115.0" text="Ciudad"/>
            <TableColumn fx:id="colEmpresa" prefWidth="145.0" text="Empresa"/>
        </columns>
        <placeholder>
            <Label text="Tabla sin contenido"/>
        </placeholder>
    </TableView>
</VBox>
